generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// USER
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               String   @default("user")       // "admin" | "user"
  isActive           Boolean  @default(true)
  forcePasswordReset Boolean  @default(false)
  dailyLimit         Int      @default(0)             // 0 = unlimited
  monthlyLimit       Int      @default(0)             // 0 = unlimited
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // SMTP config (nullable - user may not have configured yet)
  smtpHost           String?
  smtpPort           Int?
  smtpUsername       String?
  smtpPasswordEnc    String?                          // AES-256 encrypted
  smtpFromName       String?
  smtpFromEmail      String?
  smtpEncryption     String?                          // "TLS" | "SSL" | "NONE"
  smtpRejectUnauth   Boolean  @default(true)

  // Relations
  smtpHealthLogs     SmtpHealthLog[]
  emails             Email[]
  drafts             Draft[]
  templates          Template[]
  scheduledEmails    ScheduledEmail[]
  auditLogsAsActor   AuditLog[]         @relation("ActorLogs")
  auditLogsAsTarget  AuditLog[]         @relation("TargetLogs")
  announcements      Announcement[]
  dismissedAnnouncements AnnouncementDismissal[]
  emailEvents        EmailEvent[]
  qrCampaigns        QrCampaign[]
  certificateTemplates CertificateTemplate[]
}

// ---------------------------------------------------------------------------
// SMTP HEALTH LOG (was embedded array in the previous User document)
// ---------------------------------------------------------------------------

model SmtpHealthLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success     Boolean
  latencyMs   Int?
  error       String?
  testedAt    DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// EMAIL (sent log)
// ---------------------------------------------------------------------------

model Email {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Recipients - stored as JSON arrays serialized to String
  toAddresses      String                             // JSON: string[]
  ccAddresses      String?                            // JSON: string[]
  bccAddresses     String?                            // JSON: string[]
  replyTo          String?

  subject          String
  bodyHtml         String

  // Attachments - stored as JSON array of objects
  attachments      String?                            // JSON: {name,size,mimeType,path}[]

  status           String                             // "sent" | "failed" | "partial"
  errorMsg         String?
  isBulk           Boolean   @default(false)
  bulkJobId        String?
  sentAt           DateTime  @default(now())

  // Bulk send reference
  templateId       String?
  templateName     String?
  mergeData        String?                            // JSON: object

  // Retry tracking
  retryCount       Int       @default(0)
  retryHistory     String?                            // JSON: {attemptedAt,success,error}[]
  acknowledged     Boolean   @default(false)

  // Open/click tracking
  trackingEnabled  Boolean   @default(true)
  openCount        Int       @default(0)
  clickCount       Int       @default(0)
  firstOpenedAt    DateTime?
  lastOpenedAt     DateTime?

  // Relations
  events           EmailEvent[]
  clickEvents      ClickEvent[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, sentAt])
  @@index([userId, isBulk])
  @@index([userId, bulkJobId])
}

// ---------------------------------------------------------------------------
// DRAFT
// ---------------------------------------------------------------------------

model Draft {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  toAddresses String?                                 // JSON: string[]
  ccAddresses String?
  bccAddresses String?
  replyTo     String?
  subject     String?
  bodyHtml    String?
  attachments String?                                 // JSON: {name,size,mimeType,path}[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// TEMPLATE
// ---------------------------------------------------------------------------

model Template {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  subjectLine   String
  bodyHtml      String
  mergeFields   String?                               // JSON: string[]
  previewImage  String?                               // base64 dataURL
  uploadMethod  String   @default("paste")            // "file" | "paste"
  isHtml        Boolean  @default(true)
  isFavourite   Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, isFavourite])
}

// ---------------------------------------------------------------------------
// SCHEDULED EMAIL
// ---------------------------------------------------------------------------

model ScheduledEmail {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  toAddresses  String                                 // JSON: string[]
  ccAddresses  String?
  bccAddresses String?
  replyTo      String?
  subject      String
  bodyHtml     String
  attachments  String?                                // JSON array

  scheduledAt  DateTime
  status       String    @default("pending")          // "pending"|"sending"|"sent"|"failed"|"cancelled"|"missed"
  sentAt       DateTime?
  errorMsg     String?
  retryCount   Int       @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  action      String                                  // e.g. "email.sent"
  category    String                                  // "AUTH"|"EMAIL"|"ADMIN"
  userId      String
  actor       User     @relation("ActorLogs", fields: [userId], references: [id], onDelete: Cascade)
  userName    String                                  // snapshot at log time
  targetId    String?
  target      User?    @relation("TargetLogs", fields: [targetId], references: [id], onDelete: SetNull)
  targetName  String?
  metadata    String?                                 // JSON: flexible object
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ANNOUNCEMENT
// ---------------------------------------------------------------------------

model Announcement {
  id          String   @id @default(cuid())
  message     String
  type        String   @default("info")               // "info"|"warning"|"critical"
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  dismissals  AnnouncementDismissal[]

  @@index([isActive])
}

model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// EMAIL EVENT (open/click tracking)
// ---------------------------------------------------------------------------

model EmailEvent {
  id        String   @id @default(cuid())
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String                                    // "open" | "click"
  url       String?                                   // for clicks only
  ip        String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([emailId])
  @@index([userId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// SYSTEM CONFIG (singleton - global SMTP override)
// ---------------------------------------------------------------------------

model SystemConfig {
  id                 String   @id @default("singleton")
  globalSmtpActive   Boolean  @default(false)
  smtpHost           String?
  smtpPort           Int?
  smtpUsername       String?
  smtpPasswordEnc    String?
  smtpFromName       String?
  smtpFromEmail      String?
  smtpEncryption     String?
  smtpRejectUnauth   Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  updatedById        String?
}

// ---------------------------------------------------------------------------
// QR CAMPAIGN
// ---------------------------------------------------------------------------

model QrCampaign {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           String               // "checkin" | "url" | "text"
  scanMode       String               @default("once") // "once" | "unlimited"
  expiresAt      DateTime?
  isActive       Boolean              @default(true)

  brandColor     String               @default("#000000")
  bgColor        String               @default("#ffffff")
  logoUrl        String?
  cornerRadius   Int                  @default(0)
  borderSize     Int                  @default(0)
  borderColor    String               @default("#000000")
  displayFields  String               @default("[]")

  qrCodes        QrCode[]
  scanLogs       QrScanLog[]
  operators      QrCampaignOperator[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([type])
  @@index([expiresAt])
}

model QrCode {
  id             String      @id @default(cuid())
  campaignId     String
  campaign       QrCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String
  contentType    String      // "url" | "text" | "checkin"
  encodedData    String
  imageUrl       String
  recipientEmail String?
  recipientName  String?
  mergeData      String?
  status         String      @default("active") // "active" | "used" | "expired" | "invalidated"
  scanCount      Int         @default(0)
  lastScannedAt  DateTime?
  emailId        String?
  scanLogs       QrScanLog[]
  createdAt      DateTime    @default(now())

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([recipientEmail])
  @@index([recipientName])
  @@index([createdAt])
}

model QrScanLog {
  id             String      @id @default(cuid())
  qrCodeId       String
  qrCode         QrCode      @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       QrCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  operatorId     String?
  operator       QrOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  result         String      // "valid" | "invalid" | "used" | "expired"
  scannedAt      DateTime    @default(now())
  ipAddress      String?
  userAgent      String?

  @@index([qrCodeId])
  @@index([campaignId])
  @@index([operatorId])
  @@index([result])
  @@index([scannedAt])
  @@index([campaignId, scannedAt])
}

model QrOperator {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  pinHash        String
  isActive       Boolean              @default(true)
  createdBy      String
  lastScanAt     DateTime?
  totalScans     Int                  @default(0)
  campaigns      QrCampaignOperator[]
  scanLogs       QrScanLog[]
  createdAt      DateTime             @default(now())

  @@index([email])
  @@index([isActive])
  @@index([createdBy])
}

model QrCampaignOperator {
  id             String      @id @default(cuid())
  campaignId     String
  campaign       QrCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  operatorId     String
  operator       QrOperator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  assignedAt     DateTime    @default(now())

  @@unique([campaignId, operatorId])
  @@index([operatorId])
}

model CertificateTemplate {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  description     String?

  pdfBase64       String
  pdfFileName     String
  pdfSizeBytes    Int

  pageWidth       Float
  pageHeight      Float
  pageCount       Int       @default(1)

  fields          String    @default("[]")
  previewImage    String?

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  generations     CertificateGeneration[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([updatedAt])
}

model CertificateGeneration {
  id                    String               @id @default(cuid())
  templateId            String
  template              CertificateTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId                String

  bulkJobId             String?

  recipientEmail        String
  recipientName         String?
  mergeData             String?

  status                String    @default("pending")
  errorMsg              String?

  generatedAt           DateTime?
  createdAt             DateTime  @default(now())

  @@index([templateId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([recipientEmail])
}

// ---------------------------------------------------------------------------
// CLICK EVENT
// ---------------------------------------------------------------------------

model ClickEvent {
  id        String   @id @default(cuid())
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  label     String
  url       String
  ip        String?
  userAgent String?
  timestamp DateTime @default(now())

  @@map("click_events")
  @@index([emailId])
  @@index([label])
  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// RETENTION POLICY
// ---------------------------------------------------------------------------

model RetentionPolicy {
  id        String   @id @default("singleton")
  days      Int      @default(30)
  updatedAt DateTime @updatedAt

  @@map("retention_policy")
}
