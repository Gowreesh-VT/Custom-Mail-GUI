DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"
JWT_ACCESS_SECRET="your-64-char-secret"
JWT_REFRESH_SECRET="your-64-char-secret"
ENCRYPTION_SECRET="your-32-char-secret"
# Must be your public deployment URL.
# Used for QR image URLs in emails.
# No trailing slash.
NEXT_PUBLIC_APP_URL="https://yourdomain.vercel.app"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"
CRON_SECRET="your-random-cron-secret"

# PWA Push Notifications (VAPID keys)
# Generate with: npx ts-node scripts/generate-vapid-keys.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com
